# Delivered to the worker by a dedicated Secret; never include the API RSA private signing key.
# MONGO_URI reads existing owner credentials; PROTOTYPE_MONGO_URI is the separate transactional store.
MONGO_URI=<existing-primary-chat-uri>
PROTOTYPE_MONGO_URI=<same-prototype-replica-uri-as-api>
REDIS_URI=<existing-shared-redis-uri>
SANDBOX_GATEWAY_URL=https://fleet-sandbox-gw.sberai-rnd.ru
SANDBOX_GATEWAY_TOKEN=<existing-gateway-token>
PROTOTYPE_SERVICE_TOKEN=<existing-64-lowercase-hex-api-worker-bearer>
OPENROUTER_API_URL=https://or.crbrcloud.ru/api/v1
CREDS_KEY=<existing-chatrouter-encryption-key>
CREDS_IV=<existing-chatrouter-encryption-iv>
AWS_BUCKET_NAME=<existing-shared-bucket>
AWS_REGION=<existing-explicit-region>
AWS_ENDPOINT_URL=<existing-obs-endpoint>
AWS_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=<existing-storage-access-key>
AWS_SECRET_ACCESS_KEY=<existing-storage-secret-key>
